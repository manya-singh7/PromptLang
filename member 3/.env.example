# Mock mode works without an API key.
PROMPTLANG_MODE=mock
PORT=4174
PROMPTLANG_INPUT_USD_PER_MILLION=0.25
PROMPTLANG_OUTPUT_USD_PER_MILLION=1.50

# To use a real OpenAI-compatible API, change mode to api and fill these in.
# These sample prices are only for the mock estimate. Replace them with your model's current prices.
# PROMPTLANG_MODE=api
# OPENAI_API_KEY=put-your-key-here
# OPENAI_MODEL=your-model-name
# OPENAI_BASE_URL=https://api.openai.com/v1
# PROMPTLANG_INPUT_USD_PER_MILLION=your-current-input-price
# PROMPTLANG_OUTPUT_USD_PER_MILLION=your-current-output-price
