# Mock mode is the default. It uses sample outputs and illustrative prices only.
PROMPTLANG_MODE=mock
PROMPTLANG_INPUT_USD_PER_MILLION=0.25
PROMPTLANG_OUTPUT_USD_PER_MILLION=1.5
PROMPTLANG_OUTPUT_CHARS_PER_STEP=500

# Optional API mode. Keep your real key in .env and never commit it.
# PROMPTLANG_MODE=api
# OPENAI_API_KEY=
# OPENAI_MODEL=
# OPENAI_BASE_URL=https://api.openai.com/v1